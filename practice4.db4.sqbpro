CREATE TABLE orders (

	id INTEGER PRIMARY KEY, FOREIGN KEY,

	dish_id INTEGER NOT NULL, PRIMARY KEY, FOREIGN KEY

	courier_id INTEGER NOT NULL,

	order_date TEXT NOT NULL,

	address TEXT NOT NULL,

	status TEXT,

);

