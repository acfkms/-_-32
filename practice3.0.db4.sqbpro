CREATE TABLE couriers (
	id INTEGER PRIMARY KEY,
	last_name TEXT NOT NULL,
	first_name TEXT NOT NULL,
	phone INTEGER NOT NULL,
	transport TEXT
);
INSERT INTO couriers 
