CREATE TABLE orders (
	id INTEGER PRIMARY KEY, FOREIGN KEY,
	dish_id INTEGER NOT NULL, PRIMARY KEY, FOREIGN KEY
	courier_id INTEGER NOT NULL,
	order_date TEXT NOT NULL,
	address TEXT NOT NULL,
	status TEXT,
);
SELECT orders.id, couriers.last_name, dishes.name, orders.order_date, orders.status
FROM orders
JOIN dishes ON dishes.id = orders.dish_id
JOIN couriers ON couriers.id =orders.courier_id
</sql><current_tab id="0"/></tab_sql></sqlb_project>
