(5, 2, 4, '2024-03-05', NULL, 'доставлено');

--1 aaaaaa показало 4!!! колонки!!! а їх 5!!! колонок!!! одна колонка нулл тому її не порахували!!!!!!!!!!! в каунт(*) їх 5 але не можу разом показати ії бо видає помилку
SELECT COUNT(status) FROM orders01;
--2 
SELECT AVG(price) AS avg_price_for_meals_is_this_is_how_i_can_write_an_explenation_question_mark FROM dishes01;
SELECT SUM(price) AS sum_price FROM dishes01;
--4
SELECT
    COUNT(name)   AS total_dishes,
    AVG(price)   AS average_price,
    MIN(price)   AS cheapest,
    MAX(price)   AS pricier
FROM dishes01;
--5 вер прибрав все що не велосипед
SELECT COUNT(last_name) FROM couriers01 WHERE transport = 'Велосипед';</sql><current_tab id="0"/></tab_sql></sqlb_project>
